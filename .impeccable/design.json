  "narrative": {
    "northStar": "Research Atlas",
    "overview": "Research Atlas is the visual north star: a modern scientific research platform with a refined cartographic aesthetic. Cool analytical surfaces and subtle forest greens give observations a calm setting; warm orange marks fire activity, and blue distinguishes VIIRS.\n\nThe interface is observation-focused, precise, and restrained. Elegant humanist typography, meaningful visualizations, and deliberate spacing support inquiry. The confirmed anti-references are beige palettes, decorative elements, generic card collections, and dense controls.",
    "keyCharacteristics": [
      "Observation-focused structure",
      "Refined cartographic aesthetic",
      "Cool green analytical surfaces and warm orange fire activity",
      "Precise spacing, tabular measurements, and restrained controls"
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Keep forest for the application shell and selection, orange for fire observations, and blue for VIIRS identity. Use text and shape alongside color.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate analytical regions with tonal contrast and fine rules; do not add decorative shadows or floating card treatments.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the established forest shell, cool backgrounds, and white analytical surfaces.",
      "Do preserve explicit labels, tabular measurements, legends, and visible keyboard focus.",
      "Do distinguish zero observations from unavailable record extent in every visualization.",
      "Do keep geographic and historical instruments visually balanced when they appear together.",
      "Do use responsive stacking and local table scrolling to retain readable measurements."
    ],
    "donts": [
      "Don't introduce beige backgrounds, ornamental imagery, or decorative effects.",
      "Don't break the workspace into a generic collection of raised cards.",
      "Don't compress controls or type to fit a desktop composition onto a phone.",
      "Don't imply that raw counts are harmonized measurements or that zero proves no fire."
    ]
  }
}
